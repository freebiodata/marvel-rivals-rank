---
import Base from '../layouts/Base.astro';
import { SITE, LADDER } from '../data/site';

const title = 'Marvel Rivals Rank Distribution – Editable Season Table';
const description =
  'Marvel Rivals rank distribution as an editable table: view, adjust to current tracker data, and save your season snapshot in your browser. No fake official numbers.';

const faqs = [
  {
    q: 'Why doesn\'t this page ship "official" percentages?',
    a: 'Because there are none — NetEase doesn\'t publish a distribution, and third-party trackers regularly disagree with each other. Shipping one set of guessed numbers as fact is how rank myths spread. The table is editable instead.',
  },
  {
    q: 'How do I update it for this season?',
    a: 'Take the tier shares from whichever community tracker you trust, click a share in the table to edit, and save. Your table persists in your browser and feeds the <a href="/rank-percentile/">percentile calculator</a>.',
  },
  {
    q: 'What do the placeholder shares represent?',
    a: 'A bell-shaped starting point typical of hero-shooter ranked curves — explicitly a placeholder [VERIFY]. The first edit you make makes it yours.',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Base title={title} description={description} crumbs={[{ name: 'Tools', href: '/tools/' }, { name: 'Rank Distribution' }]} schema={[faqLd]}>
  <div class="page-head">
    <h1>Rank Distribution</h1>
    <div class="h1-bar"></div>
    <p class="lede">
      The season's tier table — view it, correct it with current tracker data, and save it to your browser.
      Feeds the percentile calculator directly.
    </p>
    <div class="microline"><span>Free</span><span>Editable table</span><span>Saves in your browser</span></div>
  </div>

  <div class="panel accent">
    <p style="margin:0 0 4px"><strong>Click any percentage to edit.</strong> Shares are % of ranked players per tier; keep them summing to ~100 for honest percentiles.</p>
  </div>

  <div id="wrap"></div>
  <div style="display:flex;gap:10px;flex-wrap:wrap;margin:8px 0 30px">
    <button class="btn" type="button" onclick="resetDist()">Restore placeholders</button>
  </div>

  <section class="prose">
    <h2>Why editable beats official</h2>
    <p class="note">Community trackers have published conflicting Marvel Rivals distributions all year — the game publishes none. An editable table with exact math beats a frozen guess every season. Sources and policy: <a href="/methodology/">methodology</a>.</p>

    <h2>FAQ</h2>
    {faqs.map((f) => (
      <details><summary>{f.q}</summary><p>{f.a}</p></details>
    ))}
  </section>

  <section class="prose">
    <h2>Related tools and guides</h2>
    <div class="cards">
      <a class="card" href="/rank-percentile/"><span class="ico">📊</span><h3>Rank Percentile</h3><p>Uses this table — place yourself.</p><span class="tag">Calculator</span></a>
      <a class="card" href="/guides/ranks-explained/"><span class="ico">📗</span><h3>Ranks explained</h3><p>What each tier means in practice.</p><span class="tag">Guide</span></a>
      <a class="card" href="/reset-planner/"><span class="ico">🔄</span><h3>Reset Planner</h3><p>Next season starts here.</p><span class="tag">Calculator</span></a>
    </div>
  </section>

  <div class="trust">
    <strong>Maintained by {SITE.brand}</strong> · Free, no-ads, no-account · Policy: <a href="/methodology/">Methodology</a> ·
    Found an error? <a href="/contact/">Report it</a>.
  </div>
</Base>

<script>
  const DEFAULTS = JSON.parse(document.getElementById('ladder').textContent);
  const KEY = 'rivalsrank-dist-v1';
  function load() { try { return JSON.parse(localStorage.getItem(KEY) || 'null') || JSON.parse(JSON.stringify(DEFAULTS)); } catch { return JSON.parse(JSON.stringify(DEFAULTS)); } }
  function save(t) { localStorage.setItem(KEY, JSON.stringify(t)); }
  const fmt = (n: number) => new Intl.NumberFormat('en-US', { maximumFractionDigits: 1 }).format(n);

  function render() {
    const t = load();
    const total = t.reduce((s: number, r: any) => s + r.share, 0);
    document.getElementById('wrap')!.innerHTML = `
      <div class="table-scroll"><table>
        <thead><tr><th>Tier</th><th>Share % (click to edit)</th><th>Bar</th></tr></thead>
        <tbody>
          ${t.map((r: any, i: number) => `
            <tr>
              <td><strong>${r.rank}</strong></td>
              <td><input data-i="${i}" class="share mono" type="number" min="0" max="100" step="0.1" value="${r.share}" style="width:90px;background:#0d0d11;border:2px solid #3a3a48;color:#f5f5f0;border-radius:8px;padding:4px 8px;font:inherit" /></td>
              <td style="min-width:140px"><div style="height:12px;background:var(--yellow);border:2px solid #000;width:${Math.min(100, (r.share / Math.max(...t.map((x: any) => x.share))) * 100)}%"></div></td>
            </tr>`).join('')}
          <tr><td><strong>Total</strong></td><td class="mono">${fmt(total)}%</td><td>${Math.abs(total - 100) < 1 ? '✓' : '⚠ adjust to ~100'}</td></tr>
        </tbody>
      </table></div>
      <p class="note">Saved to this browser only. The <a href="/rank-percentile/">percentile calculator</a> reads this table.</p>`;
    document.querySelectorAll<HTMLInputElement>('input.share').forEach((inp) => {
      inp.addEventListener('change', () => {
        const t2 = load();
        const i = parseInt(inp.dataset.i!, 10);
        const v = parseFloat(inp.value);
        if (Number.isFinite(v) && v >= 0) { t2[i].share = v; save(t2); render(); }
      });
    });
    (window as any).render = render;
  }
  function resetDist() { localStorage.removeItem(KEY); render(); }
  (window as any).resetDist = resetDist;
  (window as any).render = render;
  render();
</script>
<script type="application/json" id="ladder" set:html={JSON.stringify(LADDER)} />
