---
import Base from '../layouts/Base.astro';
import { SITE, TOOLS, GUIDES } from '../data/site';

const title = 'All Marvel Rivals Rank Tools';
const description =
  'Every RIVALS RANK tool in one place: RR estimator, rank percentile calculator, editable rank distribution and season reset planner — free and client-side.';
---

<Base title={title} description={description} crumbs={[{ name: 'Tools' }]}>
  <div class="page-head">
    <h1>All rank tools</h1>
    <div class="h1-bar"></div>
    <p class="lede">Four tools covering the climb: estimate it, place it, watch the field, survive the reset.</p>
  </div>

  <div class="cards">
    {TOOLS.map((t) => (
      <a class="card" href={t.href}>
        <span class="ico">{t.ico}</span>
        <h3>{t.name}</h3>
        <p>{t.desc}</p>
        <span class="tag">{t.tag}</span>
      </a>
    ))}
  </div>

  <section class="prose">
    <h2>Guides that feed the tools</h2>
    <ul>
      {GUIDES.map((g) => <li><a href={g.href}>{g.name}</a> — {g.desc}</li>)}
    </ul>
  </section>
</Base>
