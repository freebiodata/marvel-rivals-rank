---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';

const title = 'Marvel Rivals RR Estimator – Wins to Your Target Rank';
const description =
  'Free Marvel Rivals RR estimator: from your current RR to any target rank — best-case consecutive wins and the realistic count at your true win rate.';

const faqs = [
  {
    q: 'How much RR do you gain per win?',
    a: 'It varies by division and performance, and NetEase has not published exact values — community measurements put typical swings near +25/−25 in mid ranks [VERIFY]. The estimator takes your values as inputs, so measure two sessions and enter your own.',
  },
  {
    q: 'Why show both "consecutive wins" and "at your win rate"?',
    a: 'Consecutive wins is the best case and the number everyone quotes; the win-rate number is the realistic one, because losses give RR back. A 55% player needs roughly 1.8× the best-case game count — that gap is the whole truth of climbing.',
  },
  {
    q: 'Does rank reset change this?',
    a: 'Yes — each season soft-drops everyone [VERIFY the current rule in patch notes]. Run the <a href="/reset-planner/">reset planner</a> first, then bring the projected starting RR here.',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Base title={title} description={description} crumbs={[{ name: 'Tools', href: '/tools/' }, { name: 'RR Estimator' }]} schema={[faqLd]}>
  <div class="page-head">
    <h1>RR Estimator</h1>
    <div class="h1-bar"></div>
    <p class="lede">
      The climb, quantified: from your current RR to any target — the dream streak <em>and</em> the honest
      game count at your real win rate.
    </p>
    <div class="microline"><span>Free</span><span>No sign-up</span><span>Runs in your browser</span></div>
  </div>

  <form class="tool panel accent" id="rr" autocomplete="off" onsubmit="return false">
    <div class="fields">
      <label class="field"><span>Current RR</span><input id="cur" type="number" value="45" min="0" max="500" step="1" inputmode="numeric" /><small>In your current division</small></label>
      <label class="field"><span>Target RR</span><input id="tgt" type="number" value="200" min="1" step="1" inputmode="numeric" /><small>e.g. 3 divisions ≈ 300 pts of climb</small></label>
      <label class="field"><span>RR per win</span><input id="w" type="number" value="25" min="1" step="1" inputmode="numeric" /><small>[VERIFY — measure your own]</small></label>
      <label class="field"><span>RR per loss</span><input id="l" type="number" value="25" min="0" step="1" inputmode="numeric" /></label>
      <label class="field"><span>Your win rate</span><input id="wr" type="number" value="55" min="1" max="99" step="1" inputmode="numeric" /><small>% from your last 50 games</small></label>
    </div>
    <button class="btn" type="button" onclick="calcRR()">Estimate</button>
  </form>

  <div class="result" id="result" aria-live="polite"></div>

  <section class="prose">
    <h2>How it works</h2>
    <pre class="formula">gap            = target − current
best case      = ceil(gap ÷ RR per win)        → all wins
net per game   = p·W − (1−p)·L
realistic games = ceil(gap ÷ net per game)</pre>
    <p>RR values are community-reported defaults [VERIFY] — the estimator's job is the arithmetic, not guessing NetEase's numbers. Assumptions: <a href="/methodology/">methodology</a>.</p>

    <h2>FAQ</h2>
    {faqs.map((f) => (
      <details><summary>{f.q}</summary><p>{f.a}</p></details>
    ))}
  </section>

  <section class="prose">
    <h2>Related tools and guides</h2>
    <div class="cards">
      <a class="card" href="/rank-percentile/"><span class="ico">📊</span><h3>Rank Percentile</h3><p>When you get there — where does that put you?</p><span class="tag">Calculator</span></a>
      <a class="card" href="/reset-planner/"><span class="ico">🔄</span><h3>Reset Planner</h3><p>Season change first, then climb math.</p><span class="tag">Calculator</span></a>
      <a class="card" href="/guides/climbing-math/"><span class="ico">📙</span><h3>Climbing math</h3><p>Why small win-rate edges compound.</p><span class="tag">Guide</span></a>
    </div>
  </section>

  <div class="trust">
    <strong>Maintained by {SITE.brand}</strong> · Free, no-ads, no-account · Model: <a href="/methodology/">Methodology</a> ·
    Found an error? <a href="/contact/">Report it</a>.
  </div>
</Base>

<script>
  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const numv = (id: string, fb = 0) => { const v = parseFloat($(id).value); return Number.isFinite(v) ? v : fb; };
  const fmt = (n: number, d = 0) => (Number.isFinite(n) ? new Intl.NumberFormat('en-US', { maximumFractionDigits: d }).format(n) : '—');

  function calcRR() {
    const cur = numv('cur'), tgt = numv('tgt'), W = numv('w', 25), L = numv('l', 25);
    const p = Math.min(99, Math.max(1, numv('wr', 55))) / 100;
    const gap = tgt - cur;
    if (gap <= 0 || W <= 0) {
      $('result').innerHTML = `<div class="verdict ok">✅ You're already at or above the target RR.</div>`;
      return;
    }
    const best = Math.ceil(gap / W);
    const net = p * W - (1 - p) * L;
    const realistic = net > 0 ? Math.ceil(gap / net) : NaN;
    const el = document.getElementById('result')!;
    el.innerHTML = `
      <div class="stats">
        <div class="stat"><span class="k">Consecutive wins (best case)</span><span class="v">${fmt(best)}</span></div>
        <div class="stat"><span class="k">Games @ ${fmt(p * 100)}% WR</span><span class="v blue">${Number.isFinite(realistic) ? fmt(realistic) : '∞'}</span></div>
        <div class="stat"><span class="k">Net RR per game</span><span class="v red">${net >= 0 ? '+' : ''}${fmt(net, 1)}</span></div>
      </div>
      <div class="rows">
        <div class="row"><span>Gap to target</span><b>${fmt(gap)} RR</b></div>
        <div class="row"><span>Hours of queue @ ~12 min/game</span><b>${Number.isFinite(realistic) ? fmt((realistic * 12) / 60, 1) + 'h' : '—'}</b></div>
      </div>
      ${net <= 0 ? `<div class="verdict bad">❌ At this win rate the climb is net-negative — fix the win rate (or duo) before grinding.</div>` : `<div class="verdict ok">✅ Positive net per game — the climb completes, it's just a grind.</div>`}
      <p class="note">RR per win/loss are community defaults [VERIFY] — replace with your measured values. <a href="/methodology/">Methodology</a>.</p>`;
    (window as any).calcRR = calcRR;
  }
  (window as any).calcRR = calcRR;
  document.getElementById('rr')?.addEventListener('input', calcRR);
  calcRR();
</script>
